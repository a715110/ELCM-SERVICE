      <plugin>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <skip>true</skip>
            </configuration>
            <goals>
              <goal>repackage</goal>
            </goals>
            <id>repackage</id>
          </execution>
        <!-- STEP1: META-INF/build-info.properties -> /actuator/info shows the release version -->
